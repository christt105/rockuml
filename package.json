{
	"name": "rockuml",
	"version": "0.0.0",
	"description": "View, navigate and export Mermaid and PlantUML diagrams.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"lint": "eslint . --max-warnings=0",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"diagrams",
		"export"
	],
	"author": "christt105",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"obsidian": "^1.14.4",
		"tslib": "^2.9.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.1"
	}
}
